# ===== Engine =====
ENGINE_MODE=dry_run
RISK_PROFILE=aggressive
COPY_MULTIPLIER=1.25
FOLLOWER_EQUITY_USD=10000
MAX_ACTIVE_WALLETS=5
COPY_SELLS=true

MAX_COPY_NOTIONAL_PER_TRADE=1500
MAX_MARKET_EXPOSURE_USD=7500
MAX_DAILY_NOTIONAL_USD=45000
MAX_OPEN_POSITIONS=25

FEE_BPS=8
SLIPPAGE_BPS=12
LIMIT_PRICE_OFFSET=0.01

ENGINE_DB_PATH=./data/whale_copy_platform.db
ENGINE_SOCKET_PATH=/tmp/whale-copy-engine.sock
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
EXECUTION_API_BASE=
ALLOW_LIVE_SIMULATION=false
SOURCE_EQUITY_FALLBACK_USD=100000

FETCH_INTERVAL_MS=1500
ROTATION_INTERVAL_MS=120000
HEARTBEAT_INTERVAL_MS=5000
ROTATION_RANK_DELTA_THRESHOLD=8
ROTATION_CONFIDENCE_FLOOR=52
ROTATION_COOLDOWN_SECS=1800
REQUEST_TIMEOUT_MS=3500
NETWORK_RETRY_LIMIT=3
COMMAND_TAIL_DEFAULT=50
RUST_LOG=info
ENGINE_LOG_DIR=./logs
LOG_RETENTION_DAYS=7

# ===== Position Reconciliation =====
# How often to reconcile internal positions with exchange (seconds)
RECONCILIATION_INTERVAL_SECS=300
# Warning threshold for size mismatch (%)
RECONCILIATION_WARNING_PCT=5.0
# Critical threshold for size mismatch (%)
RECONCILIATION_CRITICAL_PCT=10.0
# Auto-correct internal state when discrepancies found (true/false)
RECONCILIATION_AUTO_CORRECT=false
# Pause trading if critical discrepancy detected (true/false)
RECONCILIATION_PAUSE_ON_CRITICAL=true
# API endpoint for fetching positions (defaults to Polymarket)
# RECONCILIATION_API_URL=https://api.polymarket.com/positions

# ===== Telegram Control Bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_ID=
RPC_TIMEOUT_MS=2500
TELEGRAM_POLL_TIMEOUT_SEC=45
TELEGRAM_EVENT_POLL_MS=3500
TELEGRAM_HEARTBEAT_MS=5000
COMMAND_LOG_LIMIT_DEFAULT=30

# ===== Watchdog =====
WATCHDOG_INTERVAL_SEC=12
ENGINE_HEARTBEAT_MAX_AGE_SEC=30
TELEGRAM_HEARTBEAT_MAX_AGE_SEC=40
ENGINE_SERVICE=whale-copy-engine.service
TELEGRAM_SERVICE=whale-copy-telegram.service
