[Unit]
Description=Whale Copy Platform Engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/whale-copy-platform/engine-rs
EnvironmentFile=-/etc/whale-copy-platform/engine.env
ExecStart=/opt/whale-copy-platform/engine-rs/target/release/whale-copy-engine
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
